ype":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[-280,-120],"id":"7e7a5af7-6eb5-41c0-a037-ba3220c5f8a0","name":"Mark Task Done"},{"parameters":{"resource":"message","operation":"sendMessage","chatId":"={{ $json.admin_chat_id }}","text":"={{ 'Задача #' + $json.task_no + ' завершена. Файл отправлен клиенту.' }}","additionalFields":{"appendAttribution":false}},"type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[-40,-120],"id":"a6bd6ceb-00a1-4c9a-b92e-17e14b55d018","name":"Confirm Completion to Admin","retryOnFail":true,"maxTries":3,"waitBetweenTries":5000},{"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":5}]}},"type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[-1720,820],"id":"f485392e-656b-4c03-b189-74c09a7f3400","name":"Recovery Schedule"},{"parameters":{"resource":"row","operation":"get","dataTableId":{"__rl":true,"value":"bt_bot_tasks","mode":"name"},"matchType":"anyCondition","filters":{"conditions":[{"keyName":"delivery_step","condition":"eq","keyValue":"ADMIN_CARD_PENDING"},{"keyName":"delivery_step","condition":"eq","keyValue":"SOURCE_PENDING"},{"keyName":"delivery_step","condition":"eq","keyValue":"CUSTOMER_CONFIRM_PENDING"},{"keyName":"delivery_step","condition":"eq","keyValue":"RESULT_PENDING"}]},"returnAll":true},"type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[-1480,820],"id":"fa0afa0d-ab96-4488-b90d-164a07a25923","name":"Get Pending Deliveries"},{"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const MAX_RECOVERY_ATTEMPTS = 8;\nconst MAX_RECOVERIES_PER_RUN = 20;\nconst BACKOFF_MINUTES = [5, 15, 30, 60, 180, 360, 720, 1440];\nconst now = Date.now();\n\nreturn $input.all()\n  .map(item => item.json)\n  .filter(task => Number(task.retry_count ?? 0) < MAX_RECOVERY_ATTEMPTS)\n  .filter(task => {\n    if (!task.next_retry_at) return true;\n    const retryAt = new Date(task.next_retry_at).getTime();\n    return Number.isNaN(retryAt) || retryAt <= now;\n  })\n  .sort((a, b) => {\n    const aTime = new Date(a.updatedAt ?? a.created_at ?? 0).getTime() || 0;\n    const bTime = new Date(b.updatedAt ?? b.created_at ?? 0).getTime() || 0;\n    return aTime - bTime;\n  })\n  .slice(0, MAX_RECOVERIES_PER_RUN)\n  .map(task => {\n    const retryCount = Number(task.retry_count ?? 0) + 1;\n    const delayMinutes = BACKOFF_MINUTES[Math.min(retryCount - 1, BACKOFF_MINUTES.length - 1)];\n    return {\n      json: {\n        ...task,\n        retry_count: retryCount,\n        next_retry_at: new Date(now + delayMinutes * 60 * 1000).toISOString()\n      }\n    };\n  });"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-1240,820],"id":"388de44f-013b-4e97-b7d3-3e0273a8c2c0","name":"Select Due Recoveries"},{"parameters":{"resource":"row","operation":"update","dataTableId":{"__rl":true,"value":"bt_bot_tasks","mode":"name"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"task_no","condition":"eq","keyValue":"={{ $json.task_no }}"}]},"columns":{"mappingMode":"defineBelow","value":{"retry_count":"={{ $json.retry_count }}","next_retry_at":"={{ $json.next_retry_at }}"},"schema":[{"id":"retry_count","displayName":"retry_count","required":false,"defaultMatch":false,"display":true,"type":"number","canBeUsedToMatch":true},{"id":"next_retry_at","displayName":"next_retry_at","required":false,"defaultMatch":false,"display":true,"type":"dateTime","canBeUsedToMatch":true}]},"options":{}},"type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[-1000,820],"id":"f33b5f9c-9e24-4524-a792-7f249ea67061","name":"Stamp Recovery Attempt"},{"parameters":{"mode":"expression","numberOutputs":4,"output":"={{ $json.delivery_step === 'ADMIN_CARD_PENDING' ? 0 : ($json.delivery_step === 'SOURCE_PENDING' ? 1 : ($json.delivery_step === 'CUSTOMER_CONFIRM_PENDING' ? 2 : 3)) }}"},"type":"n8n-nodes-base.switch","typeVersion":3.4,"position":[-760,820],"id":"e4280a1b-b11a-46e1-9672-46b174ea889f","name":"Recovery Step Switch"}],"connections":{"Te