{"name":"Book Translator MVP","nodes":[{"parameters":{"updates":["message"],"additionalFields":{"download":false}},"type":"n8n-nodes-base.telegramTrigger","typeVersion":1.5,"position":[-1600,0],"id":"154723c1-1e22-4743-8e99-d970d10c45bb","name":"Telegram Trigger","webhookId":"d1fa0790-a60f-4c98-a0f7-c90907ae4d05"},{"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const update = $input.first().json;\nconst m = update.message ?? {};\nconst f = m.from ?? {};\nconst c = m.chat ?? {};\nconst d = m.document ?? null;\n\nconst FALLBACK_ADMIN_USER_ID = '0'; // Optional: replace with your numeric Telegram user ID.\nconst FALLBACK_ADMIN_CHAT_ID = '0'; // Optional: replace with private/group chat ID.\n\nlet ADMIN_USER_ID = FALLBACK_ADMIN_USER_ID;\nlet ADMIN_CHAT_ID = FALLBACK_ADMIN_CHAT_ID;\ntry {\n  ADMIN_USER_ID = String($env.ADMIN_USER_ID || ADMIN_USER_ID);\n  ADMIN_CHAT_ID = String($env.ADMIN_CHAT_ID || ADMIN_CHAT_ID);\n} catch (_) {\n  // Environment access can be disabled by n8n policy; use the fallback values above.\n}\nif (ADMIN_CHAT_ID === '0' && ADMIN_USER_ID !== '0') ADMIN_CHAT_ID = ADMIN_USER_ID;\nif (ADMIN_USER_ID === '0' || ADMIN_CHAT_ID === '0') {\n  throw new Error('Setup required: set ADMIN_USER_ID and ADMIN_CHAT_ID as n8n environment variables or edit FALLBACK_ADMIN_* in this node.');\n}\n\nconst filename = d?.file_name ?? '';\nconst ext = filename.includes('.') ? filename.split('.').pop().toLowerCase() : '';\nconst text = String(m.text ?? m.caption ?? '');\n\nreturn [{\n  json: {\n    sender_id: String(f.id ?? ''),\n    chat_id: String(c.id ?? ''),\n    username: String(f.username ?? ''),\n    name: [f.first_name, f.last_name].filter(Boolean).join(' '),\n    text,\n    document_file_id: String(d?.file_id ?? ''),\n    document_filename: filename,\n    document_extension: ext,\n    reply_to_message_id: m.reply_to_message?.message_id ?? null,\n    is_start: /^\\/start(?:@\\w+)?(?:\\s|$)/i.test(text),\n    has_document: Boolean(d?.file_id),\n    is_supported_document: Boolean(d?.file_id && ['epub','pdf','docx','txt'].includes(ext)),\n    received_at: new Date().toISOString(),\n    admin_user_id: ADMIN_USER_ID,\n    admin_chat_id: ADMIN_CHAT_ID,\n    is_admin: String(f.id ?? '') === ADMIN_USER_ID\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-1380,0],"id":"04a32680-db8c-4ff4-a5c7-42e7d9bd9c2d","name":"Normalize + Config"},{"parameters":{"mode":"expression","numberOutputs":2,"output":"={{ $json.is_admin ? 0 : 1 }}"},"type":"n8n-nodes-base.switch","typeVersion":3.4,"position":[-1160,0],"id":"c829b5f1-edad-48cd-bb37-45ecb8ceaca8","name":"Role Switch"},{"parameters":{"resource":"row","operation":"rowExists","dataTableId":{"__rl":true,"value":"users","mode":"name"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"user_id","condition":"eq","keyValue":"={{ $json.sender_id }}"},{"keyName":"status","condition":"eq","keyValue":"ACTIVE"}]}},"type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[-920,240],"id":"5a9c78b6-eb92-44c5-9ec9-0e6925c46191","name":"Whitelist ACTIVE"},{"parameters":{"resource":"row","operation":"rowNotExists","dataTableId":{"__rl":true,"value":"users","mode":"name"},"matchType":"allConditions","filters":{"conditions":[{"keyName":"user_id","condition":"eq","keyValue":"={{ $json.sender_id }}"},{"keyName":"status","condition":"eq","keyValue":"ACTIVE"}]}},"type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[-920,480],"id":"81ab893c-73b3-4be2-9d05-ad50d09bc691","name":"Whitelist Missing"},{"parameters":{"resource":"message","operation":"sendMessage","chatId":"={{ $json.chat_id }}","text":"={{ 'Доступ к боту закрыт. Обратитесь к администратору, чтобы получить доступ.\\n\\nВаш Telegram ID: ' + $json.sender_id }}","additionalFields":{}},"type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[-680,480],"id":"8229961a-00f9-466d-9636-e2124449c0e8","name":"Access Denied"},{"parameters":{"mode":"expression","numberOutputs":3,"output":