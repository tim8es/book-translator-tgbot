{"name":"Book Translator MVP","nodes":[{"parameters":{"updates":["message"],"additionalFields":{"download":false}},"type":"n8n-nodes-base.telegramTrigger","typeVersion":1.2,"position":[-2620,0],"id":"86fb3624-6096-4d8e-b74e-910f498af2d0","name":"Telegram Trigger","webhookId":"ae9442cf-f9f3-42b9-bff9-0739ffd5b010"},{"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"let ADMIN_USER_ID = '';\nlet ADMIN_CHAT_ID = '';\n\nif (!ADMIN_CHAT_ID && ADMIN_USER_ID) ADMIN_CHAT_ID = ADMIN_USER_ID;\nif (!ADMIN_USER_ID || !ADMIN_CHAT_ID) {\n  throw new Error('Setup required: open Admin Config and set ADMIN_USER_ID and ADMIN_CHAT_ID.');\n}\n\nconst update = $input.first().json;\nreturn [{\n  json: {\n    ...update,\n    admin_user_id: String(ADMIN_USER_ID),\n    admin_chat_id: String(ADMIN_CHAT_ID)\n  }\n}];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-2400,0],"id":"81b3a606-3807-43de-8081-5d1c042f80fa","name":"Admin Config"},{"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"const update = $input.first().json;\nconst m = update.message ?? {};\nconst f = m.from ?? {};\nconst c = m.chat ?? {};\nconst d = m.document ?? null;\nconst cfg = $('Admin Config').first().json;\n\nconst filename = d?.file_name ?? '';\nconst ext = filename.includes('.') ? filename.split('.').pop().toLowerCase() : '';\nconst text = String(m.text ?? m.caption ?? '');\n\nreturn [{ json: {\n  telegram_update_id: Number(update.update_id ?? 0),\n  sender_id: String(f.id ?? ''),\n  chat_id: String(c.id ?? ''),\n  username: String(f.username ?? ''),\n  name: [f.first_name, f.last_name].filter(Boolean).join(' '),\n  text,\n  document_file_id: String(d?.file_id ?? ''),\n  document_filename: filename,\n  document_extension: ext,\n  reply_to_message_id: m.reply_to_message?.message_id ?? null,\n  is_start: /^\\/start(?:@\\w+)?(?:\\s|$)/i.test(text),\n  has_document: Boolean(d?.file_id),\n  is_supported_document: Boolean(d?.file_id && ['epub','pdf','docx','txt'