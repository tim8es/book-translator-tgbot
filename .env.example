# Telegram bot token is intentionally not read by the workflow JSON.
# Store it in an n8n Telegram API credential.
TELEGRAM_BOT_TOKEN=

# Preferred administrator configuration for self-hosted/local n8n.
# The Normalize + Config node reads these through $env when node env access is allowed.
ADMIN_USER_ID=
ADMIN_CHAT_ID=

# If your n8n policy blocks $env access, edit FALLBACK_ADMIN_USER_ID and
# FALLBACK_ADMIN_CHAT_ID inside the workflow node "Normalize + Config" instead.
