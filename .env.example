# Informational placeholders only.
# The MVP workflow intentionally does NOT read these variables directly because
# environment-variable access from n8n nodes can be disabled by instance policy.
#
# Store the bot token in an n8n Telegram credential.
# Set ADMIN_USER_ID and ADMIN_CHAT_ID in the workflow node named "Config" after import.

TELEGRAM_BOT_TOKEN=
ADMIN_USER_ID=
ADMIN_CHAT_ID=
